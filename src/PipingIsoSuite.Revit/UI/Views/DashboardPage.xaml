<Page x:Class="PipingIsoSuite.Revit.UI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:PipingIsoSuite.Revit.UI.ViewModels"
      Background="White" FontFamily="Segoe UI" FontSize="12">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="#F2F4F7" />
      <Setter Property="BorderBrush" Value="#C9CED6" />
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#2F6FB3" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#245A93" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,8,0,2" />
      <Setter Property="Foreground" Value="#4A5260" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,14,0,2" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Page.Resources>

  <DockPanel Margin="8">
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#4A5260" />

    <TabControl>
      <TabItem Header="Model">
        <DockPanel Margin="4">
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,6">
              <TextBlock Text="Scope" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="6,0,0,0" />
              <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" />
            </DockPanel>
            <WrapPanel>
              <Button Style="{StaticResource Primary}" Content="Assign Line Nos" Command="{Binding AssignCommand}" ToolTip="Number checked runs (all in scope when none checked)" />
              <Button Content="Validate" Command="{Binding ValidateCommand}" />
              <Button Content="Propagate to Identical" Command="{Binding PropagateCommand}" ToolTip="Copy preset parameters from the selected run to every identical loop" />
            </WrapPanel>
            <WrapPanel>
              <Button Style="{StaticResource Primary}" Content="Create ISO Views" Command="{Binding CreateViewsCommand}" />
              <Button Style="{StaticResource Primary}" Content="Create Sheets" Command="{Binding CreateSheetsCommand}" />
              <Button Content="Export EZ-ISO" Command="{Binding ExportCommand}" />
            </WrapPanel>
            <WrapPanel>
              <Button Content="Rename Views" Command="{Binding RenameCommand}" ToolTip="Re-apply the view naming rule to checked iso views" />
              <Button Content="Renumber Sheets" Command="{Binding RenumberCommand}" ToolTip="Renumber checked sheets (all sheets when none checked) in tree order" />
              <Button Content="Delete Checked" Command="{Binding DeleteCommand}" ToolTip="Delete checked iso views and sheets" />
            </WrapPanel>
            <Grid Margin="0,2,0,6">
              <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="4,3" />
              <TextBlock Text="Search line numbers, systems, levels, views…" Margin="7,0,0,0" VerticalAlignment="Center"
                         Foreground="#9AA1AC" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SearchText}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </StackPanel>

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="3*" />
              <RowDefinition Height="5" />
              <RowDefinition Height="*" MinHeight="60" />
            </Grid.RowDefinitions>

            <TreeView x:Name="Tree" ItemsSource="{Binding Items}" SelectedItemChanged="OnTreeSelectionChanged" MouseDoubleClick="OnTreeDoubleClick">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Select in Model" Command="{Binding SelectInModelCommand}" />
                  <MenuItem Header="Propagate to Identical Loops" Command="{Binding PropagateCommand}" />
                  <Separator />
                  <MenuItem Header="Rename Checked Views" Command="{Binding RenameCommand}" />
                  <MenuItem Header="Renumber Checked Sheets" Command="{Binding RenumberCommand}" />
                  <MenuItem Header="Delete Checked" Command="{Binding DeleteCommand}" />
                </ContextMenu>
              </TreeView.ContextMenu>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:TreeItem}" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Margin="0,1">
                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Border CornerRadius="3" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#8A94A6" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="System"><Setter Property="Background" Value="#2F6FB3" /></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Header"><Setter Property="Background" Value="#2E8B57" /></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Branch"><Setter Property="Background" Value="#5FA777" /></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="View"><Setter Property="Background" Value="#7B61B8" /></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Sheet"><Setter Property="Background" Value="#C0504D" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Detail}" Foreground="#7A818C" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#E3E6EB" />

            <DockPanel Grid.Row="2">
              <TextBlock DockPanel.Dock="Top" Text="Issues (double-click to select)" Style="{StaticResource Label}" Margin="0,4,0,2" />
              <ListBox x:Name="IssueList" ItemsSource="{Binding Issues}" MouseDoubleClick="OnIssueDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Kind}" Width="80" FontWeight="SemiBold" Foreground="#C0504D" />
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6">
            <TextBlock Text="Team presets" Style="{StaticResource Section}" Margin="0,0,0,2" />
            <TextBlock Text="{Binding SettingsSource}" TextWrapping="Wrap" Foreground="#7A818C" />
            <TextBlock Text="Shared JSON path (network drive)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding SharedConfigPath, UpdateSourceTrigger=LostFocus}" />
            <WrapPanel Margin="0,6,0,0">
              <Button Style="{StaticResource Primary}" Content="Save" Command="{Binding SaveSettingsCommand}" />
              <Button Content="Publish to Shared" Command="{Binding PublishSharedCommand}" />
              <Button Content="Reload from Shared" Command="{Binding ReloadSharedCommand}" />
            </WrapPanel>

            <TextBlock Text="Line numbering" Style="{StaticResource Section}" />
            <TextBlock Text="Line number parameter" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.LineNumberParameter}" />
            <TextBlock Text="Prefix" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.LineNumbering.Prefix}" />
            <TextBlock Text="Header pattern  {Prefix} {System} {SystemType} {Level} {Zone} {Seq:000}" Style="{StaticResource Label}" TextWrapping="Wrap" />
            <TextBox Text="{Binding Presets.LineNumbering.HeaderPattern}" />
            <TextBlock Text="Branch pattern  + {Header} {BranchSeq:00}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.LineNumbering.BranchPattern}" />
            <TextBlock Text="Start sequence at" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.LineNumbering.StartAt}" />
            <CheckBox Content="Overwrite existing line numbers" IsChecked="{Binding Presets.LineNumbering.OverwriteExisting}" Margin="0,8,0,0" />
            <TextBlock Text="Zone parameter (optional)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.ZoneParameter}" />
            <TextBlock Text="System codes  e.g. CHWS=CW; HWS=HW" Style="{StaticResource Label}" />
            <TextBox Text="{Binding SystemCodes, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="Level codes  e.g. Level 1=L01" Style="{StaticResource Label}" />
            <TextBox Text="{Binding LevelCodes, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="Zone codes" Style="{StaticResource Label}" />
            <TextBox Text="{Binding ZoneCodes, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="Parameters propagated to identical loops (; separated)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding PropagateParameters, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Text="Isometric views" Style="{StaticResource Section}" />
            <TextBlock Text="View name rule  {LineNumber} {System} {Level} {Role} {Header}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.Naming.ViewName}" />
            <TextBlock Text="3D view type (blank = first)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.IsoViews.ViewFamilyType}" />
            <TextBlock Text="View template (blank = none)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.IsoViews.ViewTemplate}" />
            <TextBlock Text="Orientation" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding Presets.IsoViews.Orientation}" />
            <TextBlock Text="Section box padding (mm)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.IsoViews.SectionBoxPaddingMm}" />
            <TextBlock Text="Scale 1: (0 = template/type default)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.IsoViews.Scale}" />
            <CheckBox Content="Lock view orientation" IsChecked="{Binding Presets.IsoViews.LockOrientation}" Margin="0,8,0,0" />
            <CheckBox Content="Update existing iso for the same line" IsChecked="{Binding Presets.IsoViews.UpdateExisting}" Margin="0,4,0,0" />

            <TextBlock Text="Sheets" Style="{StaticResource Section}" />
            <TextBlock Text="Title block  'Family : Type' (blank = first loaded)" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.Sheets.TitleBlock}" />
            <TextBlock Text="Sheet number rule  {Seq:000} {LineNumber} {LastLineNumber} {Count} {System}" Style="{StaticResource Label}" TextWrapping="Wrap" />
            <TextBox Text="{Binding Presets.Naming.SheetNumber}" />
            <TextBlock Text="Sheet name rule" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.Naming.SheetName}" />
            <TextBlock Text="First sheet sequence" Style="{StaticResource Label}" />
            <TextBox Text="{Binding Presets.Naming.SheetStartAt}" />
            <TextBlock Text="Viewport grid (rows × columns)" Style="{StaticResource Label}" />
            <UniformGrid Columns="2">
              <TextBox Text="{Binding Presets.Sheets.Rows}" Margin="0,0,4,0" />
              <TextBox Text="{Binding Presets.Sheets.Columns}" />
            </UniformGrid>
            <TextBlock Text="Fill order" Style="{StaticResource Label}" />
            <ComboBox ItemsSource="{Binding FillOrders}" SelectedItem="{Binding Presets.Sheets.FillOrder}" />
            <TextBlock Text="Margins inside title block (mm): left, right, top, bottom" Style="{StaticResource Label}" />
            <UniformGrid Columns="4">
              <TextBox Text="{Binding Presets.Sheets.MarginLeftMm}" Margin="0,0,4,0" />
              <TextBox Text="{Binding Presets.Sheets.MarginRightMm}" Margin="0,0,4,0" />
              <TextBox Text="{Binding Presets.Sheets.MarginTopMm}" Margin="0,0,4,0" />
              <TextBox Text="{Binding Presets.Sheets.MarginBottomMm}" />
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Page>
